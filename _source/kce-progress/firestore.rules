rules_version = '2';

// KCE Student Progress System — Firestore security rules (v2, after the independent review)
// Families see only their own children. Only the KCE admin account sees everyone.
// Families can save progress and scores for courses KCE has assigned; they cannot
// enroll students, assign courses, unlock lessons, change or delete scores, or erase progress.

service cloud.firestore {
  match /databases/{database}/documents {

    // Google sign-in only, with a verified email.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && myEmail() == 'kce@kingcretot.com'; }

    function inFamily(fid) {
      return signedIn()
        && myEmail() in get(/databases/$(database)/documents/families/$(fid)).data.parentEmails;
    }
    function courseAssigned(fid, sid, cid) {
      return cid in get(/databases/$(database)/documents/families/$(fid)/students/$(sid)).data.courses;
    }
    function smallInt(v) { return v is int && v >= 0 && v <= 500; }

    // Progress document: one per student per course.
    function validProgress() {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data;
      return d.keys().hasOnly(['items', 'attempts', 'tasks', 'unlocked', 'updatedAt'])
        && d.updatedAt == request.time
        && d.get('items', {}) is map && d.get('items', {}).size() <= 400
        && d.get('attempts', {}) is map && d.get('attempts', {}).size() <= 400
        && d.get('tasks', {}) is map && d.get('tasks', {}).size() <= 800
        // Families can add or improve entries but never erase them.
        && d.get('items', {}).keys().hasAll(old.get('items', {}).keys())
        && d.get('attempts', {}).keys().hasAll(old.get('attempts', {}).keys())
        // No more than one save per second from a family.
        && (resource == null || request.time > resource.data.get('updatedAt', timestamp.date(2000, 1, 1)) + duration.value(1, 's'));
    }
    // Families may never add, change or remove lesson unlocks (only KCE can).
    function unlocksUntouched() {
      return resource == null
        ? !('unlocked' in request.resource.data)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unlocked']);
    }

    // Score event from a family: append-only, typed and size-limited.
    function validFamilyEvent(cid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['course', 'part', 'lesson', 'lessonTitle', 'score', 'correct',
                               'total', 'mastered', 'attempt', 'questionSet', 'missed', 'by', 'at'])
        && d.keys().hasAll(['course', 'part', 'lesson', 'score', 'correct', 'total', 'mastered', 'by', 'at'])
        && d.course == cid
        && d.part is string && d.part.size() <= 40
        && d.lesson is string && d.lesson.size() <= 80
        && d.get('lessonTitle', '') is string && d.get('lessonTitle', '').size() <= 200
        && d.score is number && d.score >= 0 && d.score <= 100
        && smallInt(d.correct) && smallInt(d.total) && d.correct <= d.total
        && smallInt(d.get('attempt', 1)) && smallInt(d.get('questionSet', 1))
        && d.mastered is bool
        && d.get('missed', '') is string && d.get('missed', '').size() <= 8000
        && d.by == 'family'
        && d.at == request.time;
    }

    match /families/{fid} {
      allow read: if isAdmin() || (signedIn() && myEmail() in resource.data.parentEmails);
      allow write: if isAdmin();

      match /students/{sid} {
        allow read: if isAdmin() || inFamily(fid);
        allow write: if isAdmin();

        match /progress/{cid} {
          allow read: if isAdmin() || inFamily(fid);
          allow create, update: if isAdmin()
            || (inFamily(fid) && courseAssigned(fid, sid, cid) && validProgress() && unlocksUntouched());
          allow delete: if isAdmin();
        }

        match /events/{eid} {
          allow read: if isAdmin() || inFamily(fid);
          allow create: if isAdmin()
            || (inFamily(fid) && courseAssigned(fid, sid, request.resource.data.course)
                && validFamilyEvent(request.resource.data.course));
          allow update, delete: if isAdmin();
        }
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
